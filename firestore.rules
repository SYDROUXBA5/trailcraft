rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The website's map key: public by design (Mapbox honours it only on the
    // Trailcraft website), read by anyone, written from the console only.
    match /public/web {
      allow get: if true;
    }

    // A handler's own records: readable and writable by that account only.
    match /users/{uid}/{table}/{recordId} {
      function mine() {
        return request.auth != null
            && request.auth.uid == uid
            && table in ['handlers', 'dogs', 'layers', 'sessions', 'calibration'];
      }
      allow read, create, delete: if mine();
      // A save names the copy of the record it was made from (baseAt). If
      // the cloud now holds a different copy, another phone has changed the
      // record since this one last read it, and a blind overwrite would throw
      // that change away. So it is refused, and the phone merges the two and
      // sends the merge (sync.js put). It compares copies, not clocks, which
      // on two phones can be seconds apart.
      //
      // Only a build that knows about the check is held to it, and such a
      // build always stamps syncedAt with the server's own time, which the
      // rules see as request.time. An older build sends back whatever it
      // pulled, a stale baseAt and syncedAt included, so testing for baseAt
      // alone refused every save it made; it is let through as before.
      allow update: if mine()
                    && (request.resource.data.get('syncedAt', null) != request.time
                        || request.resource.data.get('baseAt', null) == resource.data.get('updatedAt', null));
    }

    // A live run. The id is the key: anyone holding the link can read it
    // until it expires (24 h after the run ends); only the account that
    // started it can write to it. The only listing allowed is an account
    // finding its own runs, and only to delete them with the account.
    //
    // Anyone can make an account, so what a run may hold is checked, not
    // trusted: only the fields the app writes (sync.js startLive, pushLive,
    // endLive), each of the kind it writes, the lines and texts bounded, and an
    // expiry no more than two days off (a day, plus room for a phone whose
    // clock is wrong). deleteAt is the same moment as expiresAt, as a
    // Timestamp: Firestore's clean-up (a TTL policy) reads only that kind,
    // and the rules and the viewers go on reading the number.
    match /live/{liveId} {
      function text(v, n) { return v == null || (v is string && v.size() <= n); }
      function num(v) { return v == null || v is number; }
      function flag(v) { return v == null || v is bool; }
      function block(v) { return v == null || v is map; }
      // A line of points: packed into columns (a map that says how many), or
      // left as a list when something in it was not a point.
      function points(v, n) {
        return v == null
            || (v is list && v.size() <= n)
            || (v is map && v.get('__pts', -1) is int && v.get('__pts', -1) >= 0 && v.get('__pts', -1) <= n);
      }
      // deleteAt is required only once a build writes it: phones still on an
      // older build share live runs without one, and refusing those would
      // break Share live on them. Their runs are simply not cleaned up by
      // the TTL policy; the number still bounds when viewers can read them.
      function expires(d) {
        return d.expiresAt is number && d.expiresAt <= request.time.toMillis() + 172800000
            && (!('deleteAt' in d) || (d.deleteAt is timestamp && d.deleteAt <= request.time + duration.value(48, 'h')));
      }
      // The dog, as share.js liveMeta picks it. A birthday is a date number,
      // or text in records from older builds.
      function dogOk(g) {
        return g == null
            || (g is map && g.keys().hasOnly(['name', 'breed', 'sex', 'dob', 'weightKg', 'lineM'])
                && text(g.get('name', null), 500) && text(g.get('breed', null), 500)
                && text(g.get('sex', null), 20) && num(g.get('weightKg', null)) && num(g.get('lineM', null))
                && (num(g.get('dob', null)) || text(g.get('dob', null), 40)));
      }
      function liveRun(d) {
        return d.keys().hasOnly(['v', 'kind', 'target', 'dog', 'handler', 'layer', 'laidAt', 'startedAt',
                                 'plan', 'walked', 'trail', 'hides', 'contamination', 'wx', 'k',
                                 'uid', 'expiresAt', 'deleteAt', 'ended', 'createdAt', 'at',
                                 'wps', 'endedAt', 'result'])
            && d.uid == request.auth.uid
            && expires(d)
            && text(d.get('kind', null), 20) && text(d.get('target', null), 500)
            && text(d.get('handler', null), 500) && text(d.get('layer', null), 500)
            && num(d.get('v', null)) && num(d.get('k', null)) && num(d.get('laidAt', null))
            && num(d.get('startedAt', null)) && num(d.get('createdAt', null))
            && num(d.get('at', null)) && num(d.get('endedAt', null))
            && flag(d.get('plan', null)) && flag(d.get('walked', null)) && flag(d.get('ended', null))
            && dogOk(d.get('dog', null))
            && points(d.get('trail', null), 50000) && points(d.get('hides', null), 50000)
            && points(d.get('wps', null), 5000)
            && d.get('contamination', []) is list && d.get('contamination', []).size() <= 200
            && block(d.get('wx', null)) && block(d.get('result', null));
      }
      // A minute of the dog's track: the chunk's id is its minute, two days
      // of minutes at most, and no more points than a phone takes in one.
      function column(v) { return v is list && v.size() <= 3000; }
      function livePiece(d, id) {
        return d.keys().hasOnly(['n', 'expiresAt', 'deleteAt', '__pts', 'lat', 'lon', 't', 'alt', 'dwellS'])
            && d.n is int && d.n >= 0 && d.n <= 2880 && id == string(d.n)
            && expires(d)
            && d.get('__pts', -1) is int && d.get('__pts', -1) >= 1 && d.get('__pts', -1) <= 3000
            && column(d.get('lat', [])) && column(d.get('lon', [])) && column(d.get('t', []))
            && column(d.get('alt', [])) && column(d.get('dwellS', []));
      }

      // get = opening one run by its id (the link). list = a query, which a
      // stranger could filter by expiresAt to find every run: owner only.
      allow get: if resource.data.expiresAt > request.time.toMillis()
                 || (request.auth != null && resource.data.uid == request.auth.uid);
      allow list: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && liveRun(request.resource.data);
      // The owner's own run, and it stays theirs: liveRun holds the uid to
      // the account writing, which is the one that made it.
      allow update: if request.auth != null && resource.data.uid == request.auth.uid
                    && liveRun(request.resource.data);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;

      match /chunks/{chunk} {
        allow read: if get(/databases/$(database)/documents/live/$(liveId)).data.expiresAt > request.time.toMillis()
                    || (request.auth != null
                        && get(/databases/$(database)/documents/live/$(liveId)).data.uid == request.auth.uid);
        allow create, update: if request.auth != null
                              && get(/databases/$(database)/documents/live/$(liveId)).data.uid == request.auth.uid
                              && livePiece(request.resource.data, chunk);
        allow delete: if request.auth != null
                      && get(/databases/$(database)/documents/live/$(liveId)).data.uid == request.auth.uid;
      }
    }

    // ── Squads (a demo for a chief of police) ──────────────────────────
    // Squad data is for the squad's members only: nobody else can read a
    // member list, a position or an incident, and nobody can list squads.
    // Being a member is having a record under members/ with your own
    // account's id; a record is made only with the squad's join code, or by
    // the squad's creator, who is Command. Command promotes and removes.
    // Anyone can make an account, so what each document may hold is checked
    // too: only the fields the app writes (squad.js, squad-cloud.js), each
    // of its kind and bounded.

    // A join code leads to its squad. Read one at a time, by the code, never
    // listed: holding the code is what lets someone ask to join.
    match /joinCodes/{code} {
      function codeOk(d) {
        return d.keys().hasOnly(['squadId', 'name', 'by', 'createdAt'])
            && d.squadId is string && d.squadId.size() <= 40
            && d.name is string && d.name.size() <= 60
            && d.by is string && d.by.size() <= 24
            && d.createdAt is number;
      }
      allow get: if request.auth != null;
      allow list: if false;
      // Made with its squad (or a new code), by that squad's Command, and
      // only the code the squad now holds.
      allow create: if request.auth != null && codeOk(request.resource.data)
                    && code.size() == 8
                    && getAfter(/databases/$(database)/documents/squads/$(request.resource.data.squadId)).data.code == code
                    && getAfter(/databases/$(database)/documents/squads/$(request.resource.data.squadId)/members/$(request.auth.uid)).data.role == 'command';
      allow update: if false;
      allow delete: if request.auth != null
                    && (get(/databases/$(database)/documents/squads/$(resource.data.squadId)/members/$(request.auth.uid)).data.role == 'command'
                        || get(/databases/$(database)/documents/squads/$(resource.data.squadId)).data.createdBy == request.auth.uid);
    }

    match /squads/{squadId} {
      function signedIn() { return request.auth != null; }
      function squadPath() { return /databases/$(database)/documents/squads/$(squadId); }
      function mePath() { return /databases/$(database)/documents/squads/$(squadId)/members/$(request.auth.uid); }
      // A deleted squad leaves a tombstone ({ gone: true }) rather than
      // nothing: with nothing there, a former member who knew the id could
      // make the squad again, become its Command and read what is left of
      // its incidents. A record left behind by a deletion grants nothing.
      function squadLive() { return exists(squadPath()) && get(squadPath()).data.get('gone', false) != true; }
      function isMember() { return signedIn() && exists(mePath()) && squadLive(); }
      function isCommand() { return isMember() && get(mePath()).data.role == 'command'; }
      function creator() { return get(squadPath()).data.createdBy; }
      function text(v, n) { return v is string && v.size() <= n; }
      function optText(v, n) { return v == null || text(v, n); }
      function num(v) { return v is number; }
      function optNum(v) { return v == null || v is number; }
      function role(v) { return v in ['command', 'k9', 'officer']; }
      // A TTL a little longer than the app's, for a phone whose clock is off.
      function expires(d, hours) {
        return d.expiresAt is number && d.expiresAt <= request.time.toMillis() + hours * 3600000
            && d.deleteAt is timestamp && d.deleteAt <= request.time + duration.value(hours, 'h');
      }
      // A time a phone claims for itself: a little ahead of the server for a
      // clock that runs fast, never far in the future (a dot that never goes
      // grey), never long past.
      function recent(at) {
        return at is number && at <= request.time.toMillis() + 300000 && at >= request.time.toMillis() - 600000;
      }
      function place(lat, lon) {
        return lat is number && lon is number && lat >= -90 && lat <= 90 && lon >= -180 && lon <= 180;
      }

      function squadOk(d) {
        return d.keys().hasOnly(['name', 'code', 'createdBy', 'createdAt', 'v', 'demo'])
            && text(d.name, 60) && d.name.size() > 0
            && text(d.code, 8) && d.code.size() == 8
            && d.createdBy is string && num(d.createdAt) && num(d.v) && d.demo is bool;
      }
      allow get: if isMember();
      allow list: if false;
      // Made by its creator, who is Command in the same batch.
      allow create: if signedIn() && squadOk(request.resource.data)
                    && request.resource.data.createdBy == request.auth.uid
                    && getAfter(mePath()).data.role == 'command';
      // Command may rename it or give it a new code; whose it is never changes.
      // Deleting is the creator turning it into a tombstone, kept longer
      // than anything in it can live (incidents: eight days), so that by
      // the time the clean-up takes the tombstone there is nothing left to
      // read. A tombstone never comes back.
      function tombOk(d) {
        return d.keys().hasOnly(['gone', 'createdBy', 'expiresAt', 'deleteAt']) && d.gone == true
            && d.createdBy == resource.data.createdBy && expires(d, 240)
            && d.expiresAt >= request.time.toMillis() + 192 * 3600000;
      }
      allow update: if (isCommand() && squadOk(request.resource.data)
                        && request.resource.data.createdBy == resource.data.createdBy
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'code']))
                    || (signedIn() && resource.data.createdBy == request.auth.uid
                        && resource.data.get('gone', false) != true && tombOk(request.resource.data));
      allow delete: if false;

      match /members/{uid} {
        function memberOk(d) {
          return d.keys().hasOnly(['uid', 'role', 'callSign', 'name', 'dog', 'joinedAt', 'code'])
              && d.uid == uid && role(d.role)
              && text(d.callSign, 24) && d.callSign.size() > 0
              && text(d.get('name', ''), 60) && optText(d.get('dog', null), 40)
              && num(d.joinedAt) && optText(d.get('code', null), 8);
        }
        allow read: if isMember();
        // Joining: your own record, as a K9 handler or an officer, with the
        // code the squad holds now. The creator's own record is Command.
        allow create: if signedIn() && uid == request.auth.uid && memberOk(request.resource.data)
                      && ((request.resource.data.role in ['k9', 'officer']
                           && request.resource.data.code == get(squadPath()).data.code)
                          || (request.resource.data.role == 'command'
                              && getAfter(squadPath()).data.createdBy == request.auth.uid));
        // Your own record: your call sign, your dog, K9 or officer; never
        // into or out of Command by yourself. Command changes only someone
        // else's role, and never the creator's.
        allow update: if isMember() && memberOk(request.resource.data)
                      && ((uid == request.auth.uid
                           && (request.resource.data.role == resource.data.role
                               || (resource.data.role != 'command' && request.resource.data.role in ['k9', 'officer']))
                           && request.resource.data.get('code', null) in [resource.data.get('code', null), get(squadPath()).data.code])
                          || (isCommand() && uid != request.auth.uid && uid != creator()
                              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])));
        // Leaving (not the creator, who deletes the squad instead); Command
        // removing someone (never the creator); the creator's own record
        // going with the squad, in the batch that deletes it.
        allow delete: if signedIn()
                      && ((uid == request.auth.uid && uid != creator())
                          || (isCommand() && uid != creator())
                          || (creator() == request.auth.uid && getAfter(squadPath()).data.get('gone', false) == true));
      }

      // Where an on-duty member is. Written only by that member, read by the
      // squad; deleted when they go off duty, and by the TTL policy if the
      // phone dies on duty.
      match /positions/{uid} {
        function positionOk(d) {
          return d.keys().hasOnly(['uid', 'lat', 'lon', 'acc', 'hdg', 'spd', 'at', 'expiresAt', 'deleteAt'])
              && d.uid == uid && place(d.lat, d.lon) && recent(d.at)
              && optNum(d.get('acc', null)) && optNum(d.get('hdg', null)) && optNum(d.get('spd', null))
              && expires(d, 12);
        }
        allow read: if isMember();
        allow create, update: if isMember() && uid == request.auth.uid && positionOk(request.resource.data);
        allow delete: if signedIn() && (uid == request.auth.uid || isCommand() || creator() == request.auth.uid);
      }

      // An incident: Command starts and ends it; every member reads it.
      match /incidents/{incidentId} {
        // Last seen: no later than the incident opened, no more than two
        // days before. How they left: walking, running or a vehicle. The
        // handler's brief: a way, a description, a scent article or not.
        function seenOk(d) {
          return d.get('lastSeenAt', null) == null
              || (num(d.lastSeenAt) && d.lastSeenAt <= d.startedAt && d.lastSeenAt >= d.startedAt - 172800000);
        }
        function briefOk(b) {
          return b == null
              || (b is map && b.keys().hasOnly(['dir', 'desc', 'article'])
                  && optText(b.get('dir', null), 40) && optText(b.get('desc', null), 160)
                  && (b.get('article', null) == null || b.article is bool));
        }
        function incidentOk(d) {
          return d.keys().hasOnly(['name', 'lkp', 'k9Uid', 'startedBy', 'startedAt', 'endedAt', 'status',
                                   'expiresAt', 'deleteAt', 'summary', 'lastSeenAt', 'pace', 'brief'])
              && text(d.name, 80) && d.name.size() > 0
              && d.lkp is map && place(d.lkp.lat, d.lkp.lon)
              && optText(d.get('k9Uid', null), 128)
              && d.startedBy is string && num(d.startedAt) && optNum(d.get('endedAt', null))
              && d.status in ['active', 'ended']
              && (d.get('summary', null) == null || d.summary is map)
              && seenOk(d)
              && (d.get('pace', null) == null || d.pace in ['walk', 'run', 'vehicle'])
              && briefOk(d.get('brief', null))
              && expires(d, 192);
        }
        function incidentPath() { return /databases/$(database)/documents/squads/$(squadId)/incidents/$(incidentId); }
        allow read: if isMember();
        allow create: if isCommand() && incidentOk(request.resource.data)
                      && request.resource.data.startedBy == request.auth.uid
                      && request.resource.data.status == 'active';
        // Ended is final: what the debrief replays is what happened.
        allow update: if isCommand() && incidentOk(request.resource.data)
                      && resource.data.status == 'active'
                      && request.resource.data.startedBy == resource.data.startedBy
                      // The opening time is what the clock, the rings and the
                      // last-seen limit hang on: it never moves.
                      && request.resource.data.startedAt == resource.data.startedAt;
        // Only the creator, deleting the whole squad: Command ends an
        // incident, and an ended one is the debrief's record.
        allow delete: if signedIn() && creator() == request.auth.uid;

        // A mark on the incident map. The K9 team's calls on the scent
        // (indication, lost it, re-found) come from that team only; a
        // sighting, a roadblock, a rally point or a perimeter line from any
        // member. A mark is its maker's to move or take back; Command may
        // take back any. Taking back is not deleting: the mark is marked
        // withdrawn, by whom and when, once, and stays in the log crossed out.
        match /marks/{markId} {
          function markOk(d) {
            return d.keys().hasOnly(['kind', 'by', 'at', 'lat', 'lon', 'pts', 'label', 'expiresAt', 'deleteAt'])
                && d.kind in ['indication', 'lost', 'refound', 'article', 'sighting', 'roadblock', 'rally', 'perimeter']
                && d.by == request.auth.uid && num(d.at)
                && (d.get('lat', null) == null || place(d.lat, d.lon))
                && (d.get('pts', null) == null || (d.pts is list && d.pts.size() <= 200))
                && optText(d.get('label', null), 60)
                && expires(d, 192);
          }
          function k9Ok(d) {
            return !(d.kind in ['indication', 'lost', 'refound'])
                || get(incidentPath()).data.k9Uid == request.auth.uid;
          }
          allow read: if isMember();
          // Ids are {uid}_{0-999}: a thousand marks a member at most, so
          // one phone with the code cannot run the squad's free reads dry.
          allow create: if isMember() && markOk(request.resource.data) && k9Ok(request.resource.data)
                        && markId.matches(request.auth.uid + '_[0-9]{1,3}')
                        && recent(request.resource.data.at)
                        && get(incidentPath()).data.status == 'active';
          // Withdrawn: only those two fields are added, in the withdrawer's
          // own name, at about now, to a mark not already withdrawn.
          function withdrawOk() {
            return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['withdrawnBy', 'withdrawnAt'])
                && resource.data.get('withdrawnBy', null) == null
                && request.resource.data.withdrawnBy == request.auth.uid
                && recent(request.resource.data.withdrawnAt);
          }
          allow update: if (isMember() && resource.data.by == request.auth.uid
                            && resource.data.get('withdrawnBy', null) == null
                            && markOk(request.resource.data) && request.resource.data.kind == resource.data.kind
                            && get(incidentPath()).data.status == 'active')
                        || (isMember() && (resource.data.by == request.auth.uid || isCommand()) && withdrawOk()
                            && get(incidentPath()).data.status == 'active');
          // Only by the squad's creator, and never while the incident runs:
          // the live record holds against Command too. Deleting the squad
          // ends a running incident first (squad-cloud.js deleteSquad); a
          // mark left behind its incident goes too, and expires anyway.
          allow delete: if signedIn() && creator() == request.auth.uid
                        && (!exists(incidentPath()) || get(incidentPath()).data.status == 'ended');
        }

        // Everyone's movements during the incident, a minute to a document
        // ({uid}_{minute}), for the replay at the debrief. Each member
        // writes only their own, only for an incident that is running (the
        // last minute may still arrive up to two minutes after it ends), and
        // no minute later than the incident has lasted. The call sign
        // and role ride along so a member who has since left still has a
        // name in the replay.
        match /tracks/{trackId} {
          function column(v) { return v is list && v.size() <= 600; }
          function trackOk(d) {
            return d.keys().hasOnly(['uid', 'n', 'lat', 'lon', 't', 'cs', 'role', 'expiresAt', 'deleteAt'])
                && d.uid == request.auth.uid && d.n is int && d.n >= 0 && d.n <= 2880
                && trackId == request.auth.uid + '_' + string(d.n)
                && column(d.lat) && column(d.lon) && column(d.t)
                && optText(d.get('cs', null), 24) && (d.get('role', null) == null || role(d.role))
                && expires(d, 192);
          }
          allow read: if isMember();
          allow create, update: if isMember() && trackOk(request.resource.data) && exists(incidentPath())
                                && (get(incidentPath()).data.status == 'active'
                                    || request.time.toMillis() < get(incidentPath()).data.endedAt + 120000)
                                && request.resource.data.n <= (request.time.toMillis() - get(incidentPath()).data.startedAt) / 60000 + 1;
          allow delete: if signedIn() && creator() == request.auth.uid;
        }
      }
    }

    match /{document=**} { allow read, write: if false; }
  }
}
